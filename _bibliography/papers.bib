@article{PhysRev.47.777,
  abbr              = {Resilience},
  title             = {Influence of Electrical System Resilience on User Power Supply},
  additional_info            = { | From system-level resilience to user-perceived power quality - Power Quality Training},
  abstract          = {Developed a structured technical review examining how system-level resilience decisions propagate to user-perceived power quality (PQ). The study distinguishes reliability, security, and resilience frameworks and analyzes how non-credible, indistinct disturbances—such as high RoCoF events, DER disconnections, protection miscoordination, and cyber-control interactions—manifest at the user level through voltage dips, frequency excursions, and degraded service continuity. Using real event case studies (e.g., UK 2019 disturbance) and recent literature, the work highlights that resilience is increasingly shaped by fast local mechanisms (DER reactive power control, BESS fast frequency response, adaptive protection) rather than traditional planning redundancy, emphasizing the dynamic link between system design and user supply quality.},
  location          = {National Polytechnic University Bucharest, Romania},
  year              = {2025},
  month             = {May},
  slides            = {PQ_Resilience.pdf},
  dimensions        = {true},
  selected          = {true},
  preview           = {3.4.png},
}

@article{PhysRev.47.777,
  abbr              = {DC Microgrid},
  title             = {State-Space Modeling and Stability Analysis of DC Systems},
  additional_info            = { | Impact of load & generation allocation, as well as grid connection configurations.},
  abstract          = {This project developed a detailed state-space modeling and steady-state analysis framework for a 21-node DC microgrid under realistic industrial, residential, and photovoltaic profiles. Both linearized DC power flow and nonlinear formulations (solved via fsolve) were implemented in MATLAB and benchmarked against GridCal to ensure numerical consistency. Time-series simulations assessed voltage profiles, power exchange, losses, and current stress under single and dual AC-grid connection scenarios. Results quantified the impact of network topology on voltage regulation, loss reduction, and operational flexibility, providing planning-oriented insights for converter-based DC distribution systems.},
  location          = {Polytechnic University Catalunya, Spain},
  year              = {2025},
  month             = {May},
  slides            = {DC_SSA_Report.pdf},
  pdf            = {DC_Microgrid_SSA.pdf},
