@article{PhysRev.47.777,
  abbr              = {HVDC},
  title             = {Dynamic Modeling and Droop Control Design for Multi-Terminal HVDC Systems},
  subtitle          = {MT-HVDC droop control: modeling, steady-state sharing, and dynamic performance},
  abstract          = {A multivariable droop control design methodology was developed for a four-terminal VSC-based HVDC grid connecting two wind farm converters (WFC) and two grid-side converters (GSC). The system was modeled using transfer function matrices to explicitly distinguish controlled and non-controlled voltages and currents. A frequency-domain framework based on singular value decomposition (SVD) was applied to evaluate worst-case amplification across frequencies and to impose quantitative performance constraints on voltage deviations and converter current effort. This enabled the systematic selection of the droop gain, identifying an optimal proportional gain of "𝐾 = 1/20" that satisfies voltage regulation, current limitation, and bandwidth constraints. The design was validated through time-domain simulations under power step disturbances and AC fault conditions, demonstrating robust power sharing, fast DC voltage stabilization, and safe current operation without overshoot.},
  location          = {Polytechnic University Catalunya, Spain},
  year              = {2026},
  month             = {May},
  pdf            = {example_pdf.pdf},
  repo        = {example_pdf.pdf},
  dimensions        = {true},
  selected          = {true},
  preview           = {1.1.png},
}

@article{PhysRev.47.777,
  abbr              = {Stability},
  title             = {STAMP: Small-Signal Stability Analysis Tool for Converter-Dominated Grids},
  subtitle            = {State-space linearization, eigenvalue tracking, and participation-factor insights},
  abstract          = {In a complete theory there is an element corresponding to each element of reality. A sufficient condition for the reality of a physical quantity is the possibility of predicting it with certainty, without disturbing the system. In quantum mechanics in the case of two physical quantities described by non-commuting operators, the knowledge of one precludes the knowledge of the other. Then either (1) the description of reality given by the wave function in quantum mechanics is not complete or (2) these two quantities cannot have simultaneous reality. Consideration of the problem of making predictions concerning a system on the basis of measurements made on another system that had previously interacted with it leads to the result that if (1) is false then (2) is also false. One is thus led to conclude that the description of reality as given by a wave function is not complete.},
  location          = {Polytechnic University Catalunya, Spain},
