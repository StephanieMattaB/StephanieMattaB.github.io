@article{PhysRev.47.777,
  abbr              = {HVDC},
  title             = {Dynamic Modeling and Droop Control Design for Multi-Terminal HVDC Systems},
  additional_info          = { | MT-HVDC droop control: modeling, steady-state sharing, and dynamic performance.},
  abstract          = {A multivariable droop control design methodology was developed for a four-terminal VSC-based HVDC grid connecting two wind farm converters (WFC) and two grid-side converters (GSC). The system was modeled using transfer function matrices to explicitly distinguish controlled and non-controlled voltages and currents. A frequency-domain framework based on singular value decomposition (SVD) was applied to evaluate worst-case amplification across frequencies and to impose quantitative performance constraints on voltage deviations and converter current effort. This enabled the systematic selection of the droop gain, identifying an optimal proportional gain of "𝐾 = 1/20" that satisfies voltage regulation, current limitation, and bandwidth constraints. The design was validated through time-domain simulations under power step disturbances and AC fault conditions, demonstrating robust power sharing, fast DC voltage stabilization, and safe current operation without overshoot.},
  location          = {Polytechnic University Catalunya, Spain},
  year              = {2026},
  month             = {May},
  pdf            = {droop.pdf},
  repo        = {example_pdf.pdf},
  dimensions        = {true},
  selected          = {true},
  preview           = {1.1.png},
}

@article{PhysRev.47.777,
  abbr              = {Stability},
  title             = {STAMP: Small-Signal Stability Analysis Tool for Converter-Dominated Grids},
  additional_info            = { | State-space linearization, eigenvalue tracking, and participation-factor insights.},
  abstract          = {Performed modal analysis of a hydro-dominated benchmark system under progressive replacement of synchronous generators with grid-following VSCs using the STAMP state-space toolbox (CITCEA-UPC). Eigenvalue and participation-factor analysis showed how converter control loops (PLL, current regulators, filters) reshape the spectrum, introducing poorly damped high-frequency modes and reducing natural damping in weak-grid conditions. Stability was recovered through systematic droop and time-constant tuning, demonstrating how control design—not inertia—becomes the dominant stabilizing mechanism in power-electronics-dominated grids..},
  location          = {Polytechnic University Catalunya, Spain},
  year              = {2026},
  month             = {May},
  slides            = {SSS_STAMP_Slides.pdf},
  poster            = {IBR_Poster.pdf},
  literature             = {Brazilian_PSSE_Report.pdf},
  pdf            = {SSS_STAMP_Tool.pdf},
  repo        = {example_pdf.pdf},
  dimensions        = {true},
  selected          = {true},
  preview           = {1.2.png},
}

@article{PhysRev.47.777,
  abbr              = {Optimization + ML},
  title             = {Smart Forecasting & Optimization Pipeline for Energy Trading (Spanish)},
  additional_info            = { | End-to-end ML + optimization workflow with data engineering and SCADA context.},
  abstract          = {Designed and implemented an end-to-end predictive and optimization architecture for energy trading decisions, integrating SCADA data, meteorological variables (NASA POWER, Meteoblue), and nodal market signals into a unified forecasting framework. Developed a modular feature engineering system (multi-layer architecture with temporal decomposition, lags, market spreads, and exogenous variables) and trained LSTM-based models to predict asset-level deviations and price-sensitive behaviors. Formulated and solved a regularized optimization problem (L2-penalized loss) using Gradient Descent and Nesterov acceleration to calibrate decision parameters, enabling robust DAM–RTM strategy adjustments. The pipeline translates raw 5-minute measurements into structured forecasts and optimization-driven bidding recommendations, bridging physical asset behavior with market intelligence.},
  location          = {Industrial R&D, Mexico},
  year              = {2026},
  month             = {Feb},
  slides            = {SUJIO_es.pdf},
  dimensions        = {true},
  selected          = {true},
  preview           = {1.3.png},
}

@article{PhysRev.47.777,
  abbr              = {HVDC},
  title             = {Commutation Failure Prediction in Hybrid AC/DC Grids: A Study Case in China},
  subtitle            = {Subtitle},
  abstract          = {Supported the development of an AI-based framework for commutation failure (CF) prediction in hybrid AC/DC systems with long-distance LCC-HVDC links in China. Contributed to PSCAD modeling (14–60 bus systems) to simulate thyristor commutation dynamics and generate synthetic datasets under varying firing angles, extinction angle (γ), DC current, and AC commutation voltage. Assisted in data preparation and neural network training to identify nonlinear relationships between operating conditions and CF events, contributing to a risk-oriented prediction and control strategy. Also supported the publication of a preliminary review on ML applications in modern power systems},
  location          = {Beijing Jiaotgong, China},
