@article{PhysRev.47.777,
  abbr              = {Network Studies},
  title             = {Power Flow Improvement and Reactive Power Compensation Study},
  additional_info            = { | MV Distributed Generation Allocation NEPLAN Network Studies for loss reduction and optimal reactive power management.},
  abstract          = {Conducted a steady-state power flow and reactive power compensation study using NEPLAN on a medium-voltage distribution network. The project involved load flow analysis under different loading scenarios to identify voltage deviations, thermal limit violations, and poor power factor conditions. Reactive compensation strategies were evaluated through capacitor bank placement and adjustment of generator power factors to improve voltage profiles and reduce network losses. The study demonstrated how targeted reactive power control enhances voltage stability margins and operational efficiency within technical constraints of the distribution system.},
