@article{PhysRev.47.777,
  abbr              = {VSC Control},
  title             = {Grid-Forming and Grid-Following VSC Control Report},
  additional_info            = { | Cascaded control loops, DC-link regulation, and virtual inertia concepts.},
  abstract          = {Developed and analyzed dynamic control architectures for voltage source converters operating in both grid-following (GFOL) and grid-forming (GFM) modes. Implemented detailed models including inner current loops, DC-link control, PLL synchronization (GFOL), droop-based voltage–frequency regulation (GFM), and virtual impedance shaping for improved stability and power-sharing behavior. Transient and small-signal responses were evaluated under grid disturbances, comparing synchronization-dependent control with grid-supportive operation. The study highlights how virtual impedance and droop tuning influence current limitation, fault response, and stability margins in converter-dominated systems.},
  location          = {Polytechnic University Catalunya, Spain},
  year              = {2025},
  month             = {Jan},
  pdf            = {VSC_Control_Report.pdf},
  repo        = {example_pdf.pdf},
  dimensions        = {true},
