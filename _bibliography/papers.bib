  preview           = {3.1.png},
}
@article{PhysRev.47.777,
  abbr              = {Optimization},
  title             = {Unit Commitment Modeling and Dispatch Optimization (RTE Case Study)},
  additional_info            = { | Operational constraints, scheduling logic, and economic dispatch framing},
  abstract          = {Developed a multi-period Unit Commitment (UC) model in AMPL inspired by an RTE case study, progressing from a basic economic dispatch formulation to a full MILP framework with binary on/off decisions, startup cost linearization, minimum generation limits, and minimum on-duration constraints. The project focused on translating operational power system constraints into optimization language and analyzing how increasing model realism reshapes dispatch outcomes and total system cost. Results highlighted the structural trade-offs between economic efficiency and operational feasibility in thermal-dominated generation systems.},
  location          = {Ecole Centrale Nantes, France},
